{
  "name": "lyrichub-promo",
  "version": "1.0.0",
  "private": true,
  "description": "Animated promo/explainer video for LyricHub, built with Remotion",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Master out/lyrichub-promo.mp4",
    "thumbnail": "remotion still src/index.ts Thumbnail out/thumbnail.jpg --scale=0.6666667 --image-format=jpeg --jpeg-quality=92",
    "stills": "node scripts/stills.ts",
    "script:md": "node scripts/build-script-md.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@remotion/cli": "^4.0.539",
    "@remotion/media-utils": "^4.0.539",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.539"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
