    "@tauri-apps/cli": "^2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
