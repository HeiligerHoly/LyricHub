{
  "name": "lyrichub",
  "version": "1.0.1",
  "description": "Game overlay that shows Spotify lyrics karaoke-style, in sync with the audio",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
